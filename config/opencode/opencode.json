{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["~/.config/opencode/AGENTS.md"],
  "permission": {
    "read": {
      "*": "allow",
      "/nix/store/**": "allow",
      "secrets/**": "ask",
      "~/.ssh/**": "deny",
      "~/.aws/**": "ask"
    },
    "edit": {
      "*": "ask",
      "secrets/**": "deny",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny"
    },
    "external_directory": {
      "/nix/store/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/Dotfiles/config/opencode/**": "allow",
      "~/.config/cmux/**": "allow",
      "~/.cache/**": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": {
      "*": "ask",
      "python *": "deny",
      "python3 *": "deny",
      "find *": "deny",

      "python -m pytest": "allow",
      "python -m pytest *": "allow",

      "ls *": "allow",
      "pwd": "allow",
      "date *": "allow",
      "stat *": "allow",
      "lsof *": "allow",
      "command -v *": "allow",
      "bash -n *": "allow",

      "git status *": "allow",
      "git diff *": "allow",
      "diff *": "allow",
      "git log *": "allow",
      "git show *": "allow",
      "git reflog show": "allow",
      "git reflog show *": "allow",
      "git branch --list *": "allow",
      "git branch --show-current": "allow",
      "git branch --all *": "allow",
      "git branch -a": "allow",
      "git branch -avv": "allow",
      "git remote -v": "allow",
      "git tag -l *": "allow",
      "git tag --contains *": "allow",
      "git merge-base *": "allow",
      "git for-each-ref *": "allow",
      "git blame *": "allow",
      "git ls-remote *": "allow",
      "git cat-file *": "allow",
      "git grep *": "allow",
      "git rev-parse *": "allow",
      "git rev-list *": "allow",
      "git ls-files *": "allow",
      "git rebase --show-current-patch": "allow",
      "git check-ignore *": "allow",
      "git show-ref *": "allow",
      "git worktree list *": "allow",
      "git config --get *": "allow",
      "git config --get-regexp *": "allow",
      "git commit *": "deny",
      "git push *": "deny",
      "git restore *": "deny",

      "gh pr view *": "allow",
      "gh pr diff *": "allow",
      "gh pr list *": "allow",
      "gh pr files *": "allow",
      "gh search prs *": "allow",
      "gh search issues *": "allow",
      "gh api */pulls/*/comments *": "allow",
      "gh api */pulls/*/reviews *": "allow",
      "gh api *pulls/*/files *": "allow",
      "gh api *search/issues*": "allow",
      "gh api *repos/*/branches*": "allow",
      "gh api graphql -f query=*repository(owner*pullRequest(number*reviewThreads*isResolved*": "allow",
      "gh api graphql *pullRequest*reviewThreads*": "allow",
      "gh api graphql *mutation*": "deny",

      "head *": "allow",
      "tail *": "allow",
      "echo *": "allow",
      "which *": "allow",
      "wc *": "allow",
      "jq *": "allow",
      "grep *": "allow",
      "rg *": "allow",
      "sleep *": "allow",
      "sort *": "allow",
      "true *": "allow",
      "uniq *": "allow",
      "sed *": "allow",
      "awk *": "allow",
      "basename *": "allow",
      "dirname *": "allow",

      "shellcheck *": "allow",
      "pre-commit *": "allow",
      "pre-commit run --all-files *": "deny",

      "ruff *": "allow",
      "uv run ruff *": "allow",
      "pytest *": "allow",
      "uv run pytest *": "allow",
      "uv lock --check": "allow",

      "opencode --help": "allow",
      "opencode --version": "allow",
      "opencode models *": "allow",
      "opencode debug --help": "allow",

      "just --list*": "allow",
      "just * --list*": "allow",
      "just * --help": "allow",
      "just --dry-run *": "allow",


      "kubectl config *": "allow",
      "kubectl cluster-info *": "allow",
      "kubectl api-resources *": "allow",
      "kubectl get *": "allow",
      "kubectl describe *": "allow",
      "kubectl logs *": "allow",
      "kubectl top *": "allow",
      "kubectl -n * get *": "allow",
      "kubectl -n * describe *": "allow",
      "kubectl -n * logs *": "allow",
      "kubectl -n * top *": "allow",
      "kubectl --context * get *": "allow",
      "kubectl --context * logs *": "allow",
      "kubectl cnpg psql *": "deny",

      "docker ps *": "allow",
      "docker images *": "allow",
      "docker logs *": "allow",
      "docker inspect *": "allow",
      "docker stats *": "allow",
      "docker compose ps *": "allow",
      "docker compose config *": "allow",
      "docker context ls *": "allow",

      "tofu init *": "allow",
      "tofu validate *": "allow",
      "tofu plan *": "allow",
      "tofu show *": "allow",
      "tofu state show *": "allow",
      "tofu state list *": "allow",
      "tofu output *": "allow",
      "tofu providers *": "allow",
      "tofu fmt -check *": "allow",

      "aws configure list *": "allow",
      "aws configure list-profiles": "allow",
      "aws sts get-caller-identity *": "allow",
      "aws organizations list-* *": "allow",
      "aws ecs list-* *": "allow",
      "aws bedrock list-* *": "allow",
      "aws bedrock get-* *": "allow",
      "aws s3 ls *": "allow",
      "aws * describe-* *": "allow",
      "aws ec2 get-* *": "allow",
      "aws eks list-* *": "allow",
      "aws iam list-* *": "allow",
      "aws iam get-* *": "allow",
      "aws logs get-* *": "allow",
      "aws logs get-* *": "allow",
      "aws s3api list-* *": "allow",
      "aws iam simulate-* *": "allow",
      "aws cloudwatch get-metric-statistics *": "allow",
      "aws cloudtrail lookup-events *": "allow",
      "AWS_PROFILE=* aws * describe-* *": "allow",
      "AWS_PROFILE=* aws s3api list-* *": "allow",
      "AWS_PAGER=* aws iam get-* *": "allow",

      "jsonnet *": "allow",
      "jsonnetfmt *": "allow",

      "git add *": "ask",
      "git rm *": "ask",
      "gh pr comment *": "ask",
      "gh api --method *": "ask",
      "gh api --method=*": "ask",
      "gh api * --method *": "ask",
      "gh api * --method=*": "ask",
      "gh api -X *": "ask",
      "gh api * -X *": "ask",
      "curl *": "ask",
      "node *": "ask",
      "uv run python *": "ask",
      "kubectl exec *": "ask",
      "kubectl port-forward *": "ask",
      "kubectl apply *": "ask",
      "kubectl delete *": "ask",
      "kubectl patch *": "ask",
      "kubectl scale *": "ask",
      "kubectl create *": "ask",
      "kubectl run *": "ask",
      "kubectl label *": "ask",
      "kubectl annotate *": "ask",
      "kubectl cordon *": "ask",
      "kubectl drain *": "ask",
      "kubectl --context * exec *": "ask",
      "kubectl --context * port-forward *": "ask",
      "kubectl --context * apply *": "ask",
      "kubectl --context * delete *": "ask",
      "kubectl --context * patch *": "ask",
      "kubectl --context * scale *": "ask",
      "kubectl --context * create *": "ask",
      "kubectl --context * run *": "ask",
      "kubectl --context * label *": "ask",
      "kubectl --context * annotate *": "ask",
      "kubectl --context * cordon *": "ask",
      "kubectl --context * drain *": "ask",
      "git worktree*": "ask"
    }
  },
  "agent": {
    "trust": {
      "description": "Planning and analysis agent using GPT Codex",
      "mode": "primary",
      "model": "openai/gpt-5.5",
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    }
  }
}
